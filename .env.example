# [common]
PYTHONPATH=.
JSON_SORT_KEYS=False
JWT_SECRET_KEY=common_jwt_secret
# [development]
DEV_DEBUG=True
DEV_DATABASE=dev_database
DEV_ADMIN_USER=dev_admin
DEV_ADMIN_PWD=dev_admin_pwd
DEV_CACHE_TYPE="SimpleCache"
DEV_CACHE_DEFAULT_TIMEOUT=30
# [testing]
TST_DEBUG=True
TST_DATABASE=tst_database
TST_ADMIN_USER=tst_admin
TST_ADMIN_PWD=tst_admin_pwd
TST_CACHE_TYPE="SimpleCache"
TST_CACHE_DEFAULT_TIMEOUT=30
# [production]
PRD_DEBUG=False
PRD_DATABASE=prd_database
PRD_ADMIN_USER=prd_admin
PRD_ADMIN_PWD=prd_admin_pwd
PRD_CACHE_TYPE="SimpleCache"
PRD_CACHE_DEFAULT_TIMEOUT=30
